# Tests de integración end-to-end que escribís

Creás `tests/integration/e2e-chain.test.ts` para verificar la cadena completa en entorno de test:

```typescript
// tests/integration/e2e-chain.test.ts
import { vi, describe, it, expect } from 'vitest'
import { createMockDiagnostic, createMockClient } from '@/tests/helpers/factories'
import { createMockMLPrefill } from '@/tests/helpers/ml-api-mock'

describe('Cadena completa — de ML a recomendaciones', () => {

  describe('Eslabón 1-2: Pipeline ML → Formulario', () => {
    it('el prefill de ML tiene todos los campos del formulario de diagnóstico', () => {
      const prefill = createMockMLPrefill()
      const camposFormulario = [
        'reclamos', 'mediaciones', 'cancelaciones_vendedor', 'envios_a_tiempo',
        'pubs_activas_pct', 'gasto_ads', 'ventas_ads', 'ventas_totales',
        'incidencias_pct', 'uso_full_flex_pct', 'cancelaciones_stock_pct',
        'skus_sin_stock_pct',
      ]
      for (const campo of camposFormulario) {
        expect(prefill).toHaveProperty(campo)
      }
    })

    it('data_sources trackea la fuente de cada bloque', () => {
      const prefill = createMockMLPrefill()
      expect(prefill.data_sources).toHaveProperty('salud')
      expect(prefill.data_sources).toHaveProperty('publicaciones')
      expect(prefill.data_sources).toHaveProperty('ads')
      expect(prefill.data_sources).toHaveProperty('logistica')
      expect(prefill.data_sources).toHaveProperty('stock')
    })

    it('los campos no cubiertos por la API son null', () => {
      const prefill = createMockMLPrefill()
      expect(prefill.ctr).toBeNull()              // CTR no disponible en API
      expect(prefill.dias_stock).toBeNull()        // dato interno
      expect(prefill.lead_time_reposicion).toBeNull() // dato interno
    })
  })

  describe('Eslabón 3-4: Formulario → Supabase', () => {
    it('el action de diagnóstico calcula score_global antes de persistir', async () => {
      const formData = createMockDiagnostic()
      // El score_global tiene que ser calculado por el módulo lib/scoring/
      // no puede venir del formulario directamente
      const result = await saveDiagnosticAction(formData)
      if (result.success) {
        expect(result.data.score_global).toBeGreaterThanOrEqual(0)
        expect(result.data.score_global).toBeLessThanOrEqual(100)
        // Verificar que el score coincide con lo que calcularía el motor
        const expectedScore = calcularScoreGlobal({
          score_salud: formData.score_salud,
          score_publicaciones: formData.score_publicaciones,
          score_ads: formData.score_ads,
          score_logistica: formData.score_logistica,
          score_stock: formData.score_stock,
        })
        expect(result.data.score_global).toBeCloseTo(expectedScore, 0)
      }
    })

    it('el action retorna las recomendaciones junto con el diagnóstico', async () => {
      const formData = createMockDiagnostic()
      const result = await saveDiagnosticAction(formData)
      if (result.success) {
        expect(result.data).toHaveProperty('recommendations')
        expect(result.data.recommendations.recomendaciones).toBeInstanceOf(Array)
      }
    })
  })

  describe('Eslabón 4-5: Supabase → score_history', () => {
    it('getDiagnosticHistory retorna datos después de insertar un diagnóstico', async () => {
      // Este test requiere conexión a Supabase de test
      // Si no está disponible, skip con documentación
      const history = await getDiagnosticHistory('client-1', 6)
      if (history.success) {
        // Si hay diagnósticos, tiene que haber historial
        expect(Array.isArray(history.data)).toBe(true)
      }
    })
  })

  describe('Eslabón 5-6: Diagnóstico → Motor de Recomendaciones', () => {
    it('generateRecommendations produce output válido para el diagnóstico v23', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)

      expect(result.client_id).toBe(diag.client_id)
      expect(result.recomendaciones).toBeInstanceOf(Array)
      expect(result.estrategia_general).toBeTruthy()
      expect(result.recomendacion_ads).toBeTruthy()
    })

    it('las recomendaciones tienen el formato que espera RecommendationCard', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)

      for (const rec of result.recomendaciones) {
        // Verificar que cada campo que usa RecommendationCard existe
        expect(rec.id).toBeTruthy()
        expect(rec.prioridad).toMatch(/urgente|alta|media|baja/)
        expect(rec.titulo).toBeTruthy()
        expect(rec.accion_concreta).toBeTruthy()
        expect(rec.impacto_estimado).toBeTruthy()
        expect(rec.benchmark_objetivo).toBeTruthy()
      }
    })
  })

  describe('Eslabón 6-7: Recomendaciones → UI Operator', () => {
    it('getClientRecommendations retorna el formato que espera RecommendationsPanel', async () => {
      const result = await getClientRecommendations('client-1')
      if (result.success) {
        expect(result.data).toHaveProperty('recomendaciones')
        expect(result.data).toHaveProperty('estrategia_general')
        expect(result.data).toHaveProperty('bloques_criticos')
        expect(result.data).toHaveProperty('bloques_saludables')
      }
    })
  })

  describe('Eslabón 7-8: Score → Dashboard del cliente', () => {
    it('getDiagnosticWithDelta retorna el formato que espera ClientScoreHero', async () => {
      const result = await getDiagnosticWithDelta('client-1')
      if (result.success) {
        expect(result.data).toHaveProperty('current')
        expect(result.data).toHaveProperty('delta')
        expect(result.data.current.score_global).toBeGreaterThanOrEqual(0)
      }
    })

    it('el estado se puede traducir a lenguaje simple para el cliente', () => {
      const estados = ['platinum', 'muy_bueno', 'solido', 'en_desarrollo', 'en_riesgo', 'critico']
      for (const estado of estados) {
        const simple = getEstadoSimpleParaCliente(estado)
        expect(simple).toBeTruthy()
        expect(typeof simple).toBe('string')
        // No tiene que ser el estado técnico directamente
        expect(simple).not.toBe(estado)
      }
    })
  })
})
```

