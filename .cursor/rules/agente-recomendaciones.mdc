# Tarea 4 — Motor principal [CRÍTICO]

```typescript
// lib/recommendations/engine.ts
import { BENCHMARKS } from './benchmarks'
import { ACCIONES_POR_METRICA } from './actions'
import type { DiagnosticRecommendations, Recommendation, AdsAnalysis } from './types'
import type { Database } from '@/lib/supabase/database.types'
import { getScoreStatus } from '@/lib/utils/scores'

type DiagnosticRow = Database['public']['Tables']['diagnostics']['Row']

const ESTRATEGIA_POR_ESTADO: Record<string, { accion: string; operador: string; ads: string; prioridad: string }> = {
  platinum:      { accion: 'Escalar con control',          operador: 'Mantener optimización. Detectar nuevas oportunidades.', ads: 'Aumentar inversión en top productos.',          prioridad: 'CRECIMIENTO' },
  muy_bueno:     { accion: 'Escalar con monitoreo',        operador: 'Cerrar las últimas brechas. Sostener lo que funciona.', ads: 'Escalar ads en top campañas con margen.',      prioridad: 'CRECIMIENTO' },
  solido:        { accion: 'Optimizar antes de escalar',   operador: 'Priorizar 3 publicaciones con mayor impacto.',         ads: 'No escalar ads hasta cerrar brechas.',         prioridad: 'OPTIMIZACIÓN' },
  en_desarrollo: { accion: 'Corregir brechas clave',       operador: 'Foco en top 20% SKUs con problemas detectados.',       ads: 'Frenar ads. Corregir publicaciones primero.',  prioridad: 'CORRECCIÓN' },
  en_riesgo:     { accion: 'Acción correctiva urgente',    operador: 'Atacar los 2 bloques con menor score.',                ads: 'Pausar escalado. Mantener solo lo rentable.',  prioridad: 'URGENTE' },
  critico:       { accion: 'Diagnóstico y plan de rescate',operador: 'No tocar más hasta tener plan validado.',              ads: 'Pausar toda inversión en ads.',                prioridad: 'RESCATE' },
}

export function generateRecommendations(diagnostic: DiagnosticRow): DiagnosticRecommendations {
  const scoreStatus = getScoreStatus(diagnostic.score_global)
  const estrategia = ESTRATEGIA_POR_ESTADO[scoreStatus]
  const recomendaciones: Recommendation[] = []

  // Analizar cada métrica y generar recomendación
  const metricas = [
    // Salud
    { campo: 'reclamos',               valor: diagnostic.reclamos,               categoria: 'salud',         peso: 0.30 },
    { campo: 'mediaciones',            valor: diagnostic.mediaciones,            categoria: 'salud',         peso: 0.25 },
    { campo: 'cancelaciones_vendedor', valor: diagnostic.cancelaciones_vendedor, categoria: 'salud',         peso: 0.25 },
    { campo: 'envios_a_tiempo',        valor: diagnostic.envios_a_tiempo,        categoria: 'salud',         peso: 0.20 },
    // Publicaciones
    { campo: 'pubs_activas_pct',       valor: diagnostic.pubs_activas_pct,       categoria: 'publicaciones', peso: 0.40 },
    { campo: 'pubs_optimizadas_pct',   valor: diagnostic.pubs_optimizadas_pct,   categoria: 'publicaciones', peso: 0.35 },
    { campo: 'ctr',                    valor: diagnostic.ctr,                    categoria: 'publicaciones', peso: 0.25 },
    // Logística
    { campo: 'incidencias_pct',        valor: diagnostic.incidencias_pct,        categoria: 'logistica',     peso: 0.40 },
    { campo: 'uso_full_flex_pct',      valor: diagnostic.uso_full_flex_pct,      categoria: 'logistica',     peso: 0.30 },
    { campo: 'cancelaciones_stock_pct',valor: diagnostic.cancelaciones_stock_pct,categoria: 'logistica',     peso: 0.30 },
    // Stock
    { campo: 'skus_sin_stock_pct',     valor: diagnostic.skus_sin_stock_pct,     categoria: 'stock',         peso: 0.40 },
    { campo: 'dias_stock',             valor: diagnostic.dias_stock,             categoria: 'stock',         peso: 0.35 },
    { campo: 'lead_time_reposicion',   valor: diagnostic.lead_time_reposicion,   categoria: 'stock',         peso: 0.25 },
  ] as const

  for (const metrica of metricas) {
    if (metrica.valor === null || metrica.valor === undefined) continue

    const scoreMetrica = calcularScoreMetrica(metrica.campo, metrica.valor)
    const estadoMetrica = getScoreStatus(scoreMetrica)
    const accion = ACCIONES_POR_METRICA[metrica.campo]?.[estadoMetrica]
    if (!accion) continue

    // Solo generar recomendación si hay brecha mejorable (no Platinum)
    if (estadoMetrica === 'platinum') continue

    const prioridad = getPrioridadRecomendacion(estadoMetrica, metrica.categoria as string)
    const benchmark = getBenchmarkTexto(metrica.campo, metrica.valor)

    recomendaciones.push({
      id: `${diagnostic.id}-${metrica.campo}`,
      categoria: metrica.categoria as any,
      prioridad,
      titulo: getTituloMetrica(metrica.campo),
      descripcion: getDescripcionMetrica(metrica.campo, metrica.valor, estadoMetrica),
      accion_concreta: accion,
      metrica_afectada: metrica.campo,
      impacto_estimado: calcularImpactoEstimado(metrica.campo, metrica.peso, scoreMetrica),
      benchmark_objetivo: benchmark.objetivo,
      audiencia: getAudienciaRecomendacion(metrica.campo),
      bloque: getBloqueLabel(metrica.categoria as string),
    })
  }

  // Análisis de Ads si hay datos
  const adsAnalysis = diagnostic.gasto_ads && diagnostic.ventas_ads && diagnostic.ventas_totales
    ? analyzeAds({
        margen_pre_ads: diagnostic.margen_pre_ads ?? 0,
        gasto_ads: diagnostic.gasto_ads,
        ventas_ads: diagnostic.ventas_ads,
        ventas_totales: diagnostic.ventas_totales,
      })
    : null

  if (adsAnalysis) {
    const adsRecomendacion = generarRecomendacionAds(adsAnalysis, diagnostic.id)
    if (adsRecomendacion) recomendaciones.push(adsRecomendacion)
  }

  // Ordenar por prioridad
  const ordenPrioridad = { urgente: 0, alta: 1, media: 2, baja: 3 }
  recomendaciones.sort((a, b) => ordenPrioridad[a.prioridad] - ordenPrioridad[b.prioridad])

  const bloquesCriticos = getBloquesCriticos(diagnostic)
  const bloquesSaludables = getBloquesSaludables(diagnostic)

  return {
    client_id: diagnostic.client_id,
    diagnostic_id: diagnostic.id,
    score_global: diagnostic.score_global,
    estado_global: diagnostic.estado_global,
    estrategia_general: estrategia.accion,
    recomendacion_ads: adsAnalysis?.recomendacion ?? estrategia.ads,
    recomendaciones,
    bloques_criticos: bloquesCriticos,
    bloques_saludables: bloquesSaludables,
    generated_at: new Date().toISOString(),
  }
}

export function analyzeAds(input: {
  margen_pre_ads: number
  gasto_ads: number
  ventas_ads: number
  ventas_totales: number
}): AdsAnalysis {
  const { margen_pre_ads, gasto_ads, ventas_ads, ventas_totales } = input

  if (ventas_ads === 0 || gasto_ads === 0) {
    return {
      acos: 0, roas: 0, tacos: 0, roas_minimo: 0,
      diferencial_roas: 0, margen_efectivo: 0, contribucion_neta: 0,
      estado_salud: 'sin_datos',
      recomendacion: 'Sin datos de ads. Activar publicidad para aumentar visibilidad.',
    }
  }

  const acos = (gasto_ads / ventas_ads) * 100
  const roas = ventas_ads / gasto_ads
  const tacos = (gasto_ads / ventas_totales) * 100
  const roas_minimo = margen_pre_ads > 0 ? 1 / (margen_pre_ads / 100) : 0
  const diferencial_roas = roas - roas_minimo
  const margen_efectivo = margen_pre_ads - acos
  const contribucion_neta = ventas_ads * (margen_efectivo / 100)

  // Estado de salud basado en TACOS vs margen
  const tacos_vs_margen = margen_pre_ads > 0 ? tacos / margen_pre_ads : 1
  let estado_salud: AdsAnalysis['estado_salud']
  let recomendacion: string

  if (tacos_vs_margen > 0.65) {
    estado_salud = 'critico'
    recomendacion = '🔴 CRÍTICO — TACOS supera el margen. Perdés plata globalmente. Reducir inversión en ads de inmediato.'
  } else if (diferencial_roas < 0) {
    estado_salud = 'critico'
    recomendacion = '🔴 CRÍTICO — ROAS por debajo del break-even. Cada peso en ads destruye margen.'
  } else if (tacos_vs_margen > 0.40) {
    estado_salud = 'aceptable'
    recomendacion = '🟡 ACEPTABLE — Margen ajustado. Optimizar campañas antes de escalar.'
  } else if (roas >= 6 && tacos_vs_margen < 0.13) {
    estado_salud = 'escalable'
    recomendacion = '🚀 ESCALAR CON CONTROL — ROAS saludable. Aumentar inversión en top campañas validadas.'
  } else {
    estado_salud = 'saludable'
    recomendacion = '✓ Podés escalar más agresivo — TACOS muy por debajo del margen.'
  }

  return { acos, roas, tacos, roas_minimo, diferencial_roas, margen_efectivo, contribucion_neta, estado_salud, recomendacion }
}
