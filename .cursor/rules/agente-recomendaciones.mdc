# Tarea 5 — API de recomendaciones para la UI [IMPORTANTE]

Creás una server action y una query en `lib/data/recommendations.ts` para que la UI pueda consumir las recomendaciones:

```typescript
// lib/data/recommendations.ts
import { createServerClient } from '@/lib/supabase/server'
import { generateRecommendations } from '@/lib/recommendations/engine'
import { logServerError } from '@/lib/utils/errors'
import type { ActionResult } from '@/lib/types/api'
import type { DiagnosticRecommendations } from '@/lib/recommendations/types'

// Genera recomendaciones para el diagnóstico más reciente de un cliente
export async function getClientRecommendations(
  clientId: string
): Promise<ActionResult<DiagnosticRecommendations>> {
  const supabase = await createServerClient()

  const { data: diagnostic, error } = await supabase
    .from('diagnostics')
    .select('*')
    .eq('client_id', clientId)
    .order('date', { ascending: false })
    .limit(1)
    .single()

  if (error) {
    logServerError('getClientRecommendations', error, { clientId })
    return { success: false, error: 'No se encontró diagnóstico para este cliente' }
  }

  const recommendations = generateRecommendations(diagnostic)
  return { success: true, data: recommendations }
}

// Genera recomendaciones para un diagnóstico específico (para mostrar post-guardado)
export async function getRecommendationsForDiagnostic(
  diagnosticId: string
): Promise<ActionResult<DiagnosticRecommendations>> {
  const supabase = await createServerClient()

  const { data: diagnostic, error } = await supabase
    .from('diagnostics')
    .select('*')
    .eq('id', diagnosticId)
    .single()

  if (error) {
    logServerError('getRecommendationsForDiagnostic', error, { diagnosticId })
    return { success: false, error: 'Diagnóstico no encontrado' }
  }

  const recommendations = generateRecommendations(diagnostic)
  return { success: true, data: recommendations }
}

// Genera recomendaciones urgentes de todas las cuentas del operator
// Para el panel de alertas de Nacho y el dashboard de Luciano
export async function getUrgentRecommendationsForOperator(
  operatorId: string
): Promise<ActionResult<Array<{ client_name: string; client_id: string; recommendations: DiagnosticRecommendations }>>> {
  const supabase = await createServerClient()

  // Traer los diagnósticos más recientes de todos los clientes activos
  const { data: clients, error } = await supabase
    .from('clients')
    .select(`
      id,
      name,
      diagnostics (*)
    `)
    .eq('operator_id', operatorId)
    .eq('active', true)
    .order('date', { foreignTable: 'diagnostics', ascending: false })
    .limit(1, { foreignTable: 'diagnostics' })

  if (error) {
    logServerError('getUrgentRecommendationsForOperator', error, { operatorId })
    return { success: false, error: 'Error al cargar recomendaciones urgentes' }
  }

  const results = (clients ?? [])
    .filter(c => c.diagnostics && c.diagnostics.length > 0)
    .map(c => ({
      client_name: c.name,
      client_id: c.id,
      recommendations: generateRecommendations(c.diagnostics[0] as any),
    }))
    .filter(r => r.recommendations.recomendaciones.some(rec => rec.prioridad === 'urgente' || rec.prioridad === 'alta'))
    .sort((a, b) => a.recommendations.score_global - b.recommendations.score_global) // peores primero

  return { success: true, data: results }
}
```

