```typescript
// lib/recommendations/types.ts

export type RecommendationPriority = 'urgente' | 'alta' | 'media' | 'baja'
export type RecommendationCategory = 'salud' | 'publicaciones' | 'ads' | 'logistica' | 'stock'
export type RecommendationAudience = 'operator' | 'client' | 'both'

export type Recommendation = {
  id: string                          // identificador único para tracking
  categoria: RecommendationCategory
  prioridad: RecommendationPriority
  titulo: string                      // acción corta: "Revisar proceso post-venta"
  descripcion: string                 // por qué importa, qué está pasando
  accion_concreta: string             // qué hacer exactamente: "Llevar reclamos a <0.5%"
  metrica_afectada: string            // qué métrica mejora si se ejecuta
  impacto_estimado: string            // cuánto puede mejorar el score
  benchmark_objetivo: string          // qué valor objetivo hay que alcanzar
  audiencia: RecommendationAudience   // quién ve esta recomendación
  bloque: string                      // '01 Salud', '02 Publicaciones', etc.
}

export type DiagnosticRecommendations = {
  client_id: string
  diagnostic_id: string
  score_global: number
  estado_global: string
  estrategia_general: string          // la acción principal según el estado global
  recomendacion_ads: string           // recomendación específica del módulo de ads
  recomendaciones: Recommendation[]  // ordenadas por prioridad
  bloques_criticos: string[]          // los bloques que necesitan atención urgente
  bloques_saludables: string[]        // los bloques que están bien
  generated_at: string
}

export type MetricaBenchmark = {
  metrica: string
  valor: number
  estado: string
  benchmark_texto: string
  accion: string
  objetivo: string
  brecha: number | null               // diferencia entre valor actual y objetivo
}

export type AdsAnalysis = {
  acos: number
  roas: number
  tacos: number
  roas_minimo: number
  diferencial_roas: number
  margen_efectivo: number
  contribucion_neta: number
  estado_salud: 'critico' | 'aceptable' | 'saludable' | 'escalable' | 'sin_datos'
  recomendacion: string
}
