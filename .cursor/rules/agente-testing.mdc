import { mapReputationToDiagnostic } from '@/lib/ml/endpoints/reputation'
import { createMockMLReputation } from '@/tests/helpers/ml-api-mock'

describe('ML Mappers — transforman API response → campos de diagnóstico', () => {
  describe('mapReputationToDiagnostic', () => {
    it('mapea claims.rate correctamente a reclamos %', () => {
      const rep = createMockMLReputation({
        metrics: {
          claims: { rate: 0.006 }, // 0.6%
          delayed_handling_time: { rate: 0.10 }, // 10% tardíos = 90% a tiempo
          cancellations: { rate: 0.003 },
        }
      })
      const result = mapReputationToDiagnostic(rep as any)
      expect(result.reclamos).toBeCloseTo(0.6, 1)
    })

    it('mapea delayed_handling_time.rate como inverso de envíos a tiempo', () => {
      const rep = createMockMLReputation({
        metrics: {
          claims: { rate: 0.006 },
          delayed_handling_time: { rate: 0.10 }, // 10% tardíos → 90% a tiempo
          cancellations: { rate: 0.003 },
        }
      })
      const result = mapReputationToDiagnostic(rep as any)
      expect(result.envios_a_tiempo).toBeCloseTo(90, 0)
    })

    it('todos los campos mapeados son números válidos entre 0 y 100', () => {
      const rep = createMockMLReputation()
      const result = mapReputationToDiagnostic(rep as any)
      for (const [key, value] of Object.entries(result)) {
        if (value !== null) {
          expect(typeof value).toBe('number')
          expect(value).toBeGreaterThanOrEqual(0)
          expect(value).toBeLessThanOrEqual(100)
        }
      }
    })
  })
})
