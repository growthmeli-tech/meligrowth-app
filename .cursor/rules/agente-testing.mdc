describe('Bloque 03 — Ads', () => {
  describe('Cálculos automáticos', () => {
    it('ACOS = gasto_ads / ventas_ads × 100', () => {
      expect(calcularACOS(20000, 10000)).toBeCloseTo(200, 1)
    })

    it('ROAS = ventas_ads / gasto_ads', () => {
      expect(calcularROAS(10000, 20000)).toBeCloseTo(0.5, 2)
    })

    it('TACOS = gasto_ads / ventas_totales × 100', () => {
      expect(calcularTACOS(20000, 30000)).toBeCloseTo(66.7, 1)
    })

    it('ROAS mínimo = 1 / margen_pre_ads', () => {
      expect(calcularROASMinimo(0.30)).toBeCloseTo(3.33, 2)
    })

    it('no divide por cero cuando ventas_ads es 0', () => {
      expect(() => calcularACOS(3000, 0)).not.toThrow()
      expect(calcularACOS(3000, 0)).toBe(null) // o Infinity manejado
    })
  })

  describe('Caso CRÍTICO — diagnóstico v23 de la planilla', () => {
    it('TACOS 66.7% > margen 30% → estado CRÍTICO', () => {
      const resultado = analyzeAds({
        margen_pre_ads: 30,
        gasto_ads: 20000,
        ventas_ads: 10000,
        ventas_totales: 30000,
      })
      expect(resultado.estado_salud).toBe('critico')
      expect(resultado.recomendacion).toMatch(/CRÍTICO/i)
    })

    it('ROAS 0.5x < ROAS mínimo 3.33x → diferencial negativo', () => {
      const resultado = analyzeAds({
        margen_pre_ads: 30,
        gasto_ads: 20000,
        ventas_ads: 10000,
        ventas_totales: 30000,
      })
      expect(resultado.diferencial_roas).toBeLessThan(0)
    })
  })

  describe('Caso SALUDABLE — puede escalar', () => {
    it('TACOS 4% con margen 30% → podés escalar', () => {
      const resultado = analyzeAds({
        margen_pre_ads: 30,
        gasto_ads: 3000,
        ventas_ads: 10000,
        ventas_totales: 30000,
      })
      expect(['saludable', 'escalable']).toContain(resultado.estado_salud)
    })
  })

  describe('Sin datos de ads', () => {
    it('gasto_ads 0 → estado SIN_DATOS, no penaliza score global', () => {
      const resultado = analyzeAds({
        margen_pre_ads: 30,
        gasto_ads: 0,
        ventas_ads: 0,
        ventas_totales: 30000,
      })
      expect(resultado.estado_salud).toBe('sin_datos')
    })
  })
})
