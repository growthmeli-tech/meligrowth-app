  getValidAccessToken: vi.fn().mockResolvedValue('mock_token'),
}))

describe('ML Pipeline — fetchMLDiagnosticData', () => {
  it('retorna success:true con prefill cuando todos los endpoints responden', async () => {
    // Mockear todos los endpoints de ML
    vi.mock('@/lib/ml/endpoints/reputation', () => ({
      getSellerReputation: vi.fn().mockResolvedValue(createMockMLReputation()),
      mapReputationToDiagnostic: vi.fn().mockReturnValue({ reclamos: 0.6 }),
    }))
    // ... más mocks

    const result = await fetchMLDiagnosticData('client-1', '123456789')
    expect(result.success).toBe(true)
    if (result.success) {
      expect(result.data.seller_id).toBe('123456789')
      expect(result.data.data_sources).toBeDefined()
    }
  })

  it('retorna success:false cuando no hay sesión válida', async () => {
    vi.mocked(getValidAccessToken).mockRejectedValueOnce(
      new Error('No hay sesión válida')
    )
    const result = await fetchMLDiagnosticData('client-1', '123456789')
    expect(result.success).toBe(false)
    if (!result.success) expect(result.error).toMatch(/sesión/i)
  })

  it('continúa con los demás bloques aunque uno falle', async () => {
    // Un endpoint falla → el pipeline no explota, marca ese bloque como unavailable
    const result = await fetchMLDiagnosticData('client-1', '123456789')
    if (result.success) {
      // Algún bloque puede ser unavailable pero el pipeline retorna igual
      expect(result.data.data_sources).toBeDefined()
    }
  })

  it('el data_sources trackea correctamente la fuente de cada bloque', async () => {
    const result = await fetchMLDiagnosticData('client-1', '123456789')
    if (result.success) {
      const validSources = ['api', 'scraper', 'manual', 'unavailable']
      for (const source of Object.values(result.data.data_sources)) {
        expect(validSources).toContain(source)
      }
    }
  })
})
