## `tests/unit/lib/recommendations/engine.test.ts`
```typescript
import { generateRecommendations } from '@/lib/recommendations/engine'
import { createMockDiagnostic, createPlatinumDiagnostic } from '@/tests/helpers/factories'

describe('Motor de Recomendaciones — generateRecommendations', () => {
  describe('Priorización correcta', () => {
    it('genera recomendación URGENTE cuando envíos a tiempo < 88%', () => {
      const diag = createMockDiagnostic({ envios_a_tiempo: 85 })
      const result = generateRecommendations(diag)
      const urgentes = result.recomendaciones.filter(r => r.prioridad === 'urgente')
      expect(urgentes.length).toBeGreaterThan(0)
    })

    it('primera recomendación es siempre la más urgente', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)
      const prioridades = result.recomendaciones.map(r => r.prioridad)
      const ordenEsperado = ['urgente', 'alta', 'media', 'baja']
      for (let i = 1; i < prioridades.length; i++) {
        const prevIdx = ordenEsperado.indexOf(prioridades[i - 1])
        const currIdx = ordenEsperado.indexOf(prioridades[i])
        expect(prevIdx).toBeLessThanOrEqual(currIdx)
      }
    })

    it('cuenta Platinum → sin recomendaciones urgentes', () => {
      const diag = createPlatinumDiagnostic()
      const result = generateRecommendations(diag)
      const urgentes = result.recomendaciones.filter(r => r.prioridad === 'urgente')
      expect(urgentes).toHaveLength(0)
    })

    it('no genera recomendaciones para métricas en estado Platinum', () => {
      const diag = createMockDiagnostic({
        reclamos: 0.1, // Platinum
      })
      const result = generateRecommendations(diag)
      const reclamoRec = result.recomendaciones.find(r => r.metrica_afectada === 'reclamos')
      expect(reclamoRec).toBeUndefined()
    })
  })

  describe('Caso real v23 — diagnóstico con Ads CRÍTICO', () => {
    it('diagnóstico v23 genera recomendación urgente en Ads', () => {
      const diag = createMockDiagnostic() // v23: ACOS 200%, ROAS 0.5x
      const result = generateRecommendations(diag)
      const adsRec = result.recomendaciones.find(r => r.categoria === 'ads')
      expect(adsRec?.prioridad).toBe('urgente')
    })

    it('estrategia general EN RIESGO → acción correctiva urgente', () => {
      const diag = createMockDiagnostic({ score_global: 63 })
      const result = generateRecommendations(diag)
      expect(result.estrategia_general).toMatch(/correctiva|urgente/i)
    })

    it('recomendación de ads incluye análisis TACOS vs margen', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)
      expect(result.recomendacion_ads).toMatch(/CRÍTICO|TACOS|margen/i)
    })
  })

  describe('Estructura de recomendaciones', () => {
    it('cada recomendación tiene todos los campos requeridos', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)
      for (const rec of result.recomendaciones) {
        expect(rec).toHaveProperty('id')
        expect(rec).toHaveProperty('categoria')
        expect(rec).toHaveProperty('prioridad')
        expect(rec).toHaveProperty('titulo')
        expect(rec).toHaveProperty('accion_concreta')
        expect(rec).toHaveProperty('benchmark_objetivo')
        expect(rec).toHaveProperty('audiencia')
      }
    })

    it('recomendaciones de Salud tienen audiencia operator o both', () => {
      const diag = createMockDiagnostic()
      const result = generateRecommendations(diag)
      const saludRecs = result.recomendaciones.filter(r => r.categoria === 'salud')
      for (const rec of saludRecs) {
        expect(['operator', 'both']).toContain(rec.audiencia)
      }
    })
  })
})
