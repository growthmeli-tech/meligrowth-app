# Tarea 4 — Pipeline completo [CRÍTICO]

```typescript
// lib/ml/pipeline.ts
// Orquesta todos los endpoints y devuelve los datos para pre-llenar el diagnóstico

import { getValidAccessToken } from './auth'
import { getSellerReputation, mapReputationToDiagnostic } from './endpoints/reputation'
import { getListingsStats, getListingsOptimizationRate, mapListingsToDiagnostic } from './endpoints/listings'
import { getAdsMetrics, mapAdsToDiagnostic } from './endpoints/ads'
import { getLogisticsMetrics } from './endpoints/logistics'
import { getStockMetrics } from './endpoints/stock'
import { logServerError } from '@/lib/utils/errors'

export type MLDiagnosticPrefill = {
  // Bloque 01 Salud
  reclamos?: number | null
  mediaciones?: number | null
  cancelaciones_vendedor?: number | null
  envios_a_tiempo?: number | null
  // Bloque 02 Publicaciones
  pubs_activas_pct?: number | null
  pubs_optimizadas_pct?: number | null
  ctr?: number | null
  // Bloque 03 Ads
  gasto_ads?: number | null
  ventas_ads?: number | null
  ventas_totales?: number | null
  // Bloque 04 Logística
  incidencias_pct?: number | null
  uso_full_flex_pct?: number | null
  cancelaciones_stock_pct?: number | null
  // Bloque 05 Stock
  skus_sin_stock_pct?: number | null
  dias_stock?: number | null
  lead_time_reposicion?: number | null
  // Metadata
  seller_id: string
  synced_at: string
  data_sources: Record<string, 'api' | 'scraper' | 'manual' | 'unavailable'>
}

export async function fetchMLDiagnosticData(
  clientId: string,
  sellerId: string
): Promise<{ success: true; data: MLDiagnosticPrefill } | { success: false; error: string }> {

  let accessToken: string
  try {
    accessToken = await getValidAccessToken(clientId)
  } catch (err) {
    logServerError('fetchMLDiagnosticData:auth', err, { clientId, sellerId })
    return { success: false, error: 'No hay sesión válida con Mercado Libre. El seller necesita reautorizar.' }
  }

  const dataSources: Record<string, 'api' | 'scraper' | 'manual' | 'unavailable'> = {}
  const prefill: Partial<MLDiagnosticPrefill> = { seller_id: sellerId, synced_at: new Date().toISOString() }

  // Bloque 01 — Salud
  try {
    const reputation = await getSellerReputation(sellerId, accessToken)
    const salud = mapReputationToDiagnostic(reputation)
    Object.assign(prefill, salud)
    dataSources.salud = 'api'
  } catch (err) {
    logServerError('fetchMLDiagnosticData:reputation', err, { sellerId })
    dataSources.salud = 'unavailable'
  }

  // Bloque 02 — Publicaciones
  try {
    const stats = await getListingsStats(sellerId, accessToken)
    const optimRate = await getListingsOptimizationRate(sellerId, accessToken)
    const pubs = mapListingsToDiagnostic(stats, optimRate)
    Object.assign(prefill, pubs)
    dataSources.publicaciones = 'api'
  } catch (err) {
    logServerError('fetchMLDiagnosticData:listings', err, { sellerId })
    dataSources.publicaciones = 'unavailable'
  }

  // Bloque 03 — Ads
  try {
    const dateFrom = new Date()
    dateFrom.setDate(dateFrom.getDate() - 30)
    const ads = await getAdsMetrics(
      sellerId,
      accessToken,
      dateFrom.toISOString().split('T')[0],
      new Date().toISOString().split('T')[0]
    )
    const adsMapped = mapAdsToDiagnostic(ads)
    Object.assign(prefill, adsMapped)
    dataSources.ads = ads ? 'api' : 'unavailable'
  } catch (err) {
    logServerError('fetchMLDiagnosticData:ads', err, { sellerId })
    dataSources.ads = 'unavailable'
  }

  // Bloque 04 — Logística
  try {
    const logistics = await getLogisticsMetrics(sellerId, accessToken)
    if (logistics) Object.assign(prefill, logistics)
    dataSources.logistica = logistics ? 'api' : 'unavailable'
  } catch (err) {
    logServerError('fetchMLDiagnosticData:logistics', err, { sellerId })
    dataSources.logistica = 'unavailable'
  }

  // Bloque 05 — Stock
  try {
    const stock = await getStockMetrics(sellerId, accessToken)
    if (stock) Object.assign(prefill, stock)
    dataSources.stock = stock ? 'api' : 'unavailable'
  } catch (err) {
    logServerError('fetchMLDiagnosticData:stock', err, { sellerId })
    dataSources.stock = 'unavailable'
  }

  prefill.data_sources = dataSources

  return { success: true, data: prefill as MLDiagnosticPrefill }
}
```

