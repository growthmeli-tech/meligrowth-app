```typescript
import { mlFetch } from '../client'

export async function getLogisticsMetrics(sellerId: string, accessToken: string) {
  const thirtyDaysAgo = new Date()
  thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30)
  const dateFrom = thirtyDaysAgo.toISOString().split('T')[0]

  // Órdenes del último mes
  const orders = await mlFetch<{
    results: Array<{
      status: string
      cancel_detail?: { description: string }
      shipping: { status: string; substatus: string | null }
    }>
    paging: { total: number }
  }>(
    `/orders/search?seller=${sellerId}&order.date_created.from=${dateFrom}&limit=50`,
    accessToken
  )

  const total = orders.paging.total
  if (total === 0) return null

  // Calcular métricas
  let incidencias = 0
  let cancelaciones_stock = 0
  let full_flex = 0

  for (const order of orders.results) {
    if (order.shipping?.substatus === 'bad_user_info' ||
        order.shipping?.substatus === 'bad_address') {
      incidencias++
    }
    if (order.status === 'cancelled' &&
        order.cancel_detail?.description?.includes('stock')) {
      cancelaciones_stock++
    }
  }

  // Items en Full/Flex
  const fullItems = await mlFetch<{ paging: { total: number } }>(
    `/users/${sellerId}/items/search?logistic_type=fulfillment&limit=1`,
    accessToken
  )
  const allItems = await mlFetch<{ paging: { total: number } }>(
    `/users/${sellerId}/items/search?status=active&limit=1`,
    accessToken
  )

  if (allItems.paging.total > 0) {
    full_flex = (fullItems.paging.total / allItems.paging.total) * 100
  }

  return {
    incidencias_pct: (incidencias / total) * 100,
    cancelaciones_stock_pct: (cancelaciones_stock / total) * 100,
    uso_full_flex_pct: full_flex,
  }
}
```

## `lib/ml/endpoints/stock.ts` — Bloque 05 Stock
```typescript
import { mlFetch } from '../client'

export async function getStockMetrics(sellerId: string, accessToken: string) {
  // Items activos y sus quantidades disponibles
  const items = await mlFetch<{
    results: string[]
    paging: { total: number }
  }>(
    `/users/${sellerId}/items/search?status=active&limit=50`,
    accessToken
  )

  if (!items.results.length) return null

  // Obtener available_quantity de cada item
  const itemDetails = await Promise.allSettled(
    items.results.slice(0, 50).map(id =>
      mlFetch<{ id: string; available_quantity: number }>(
        `/items/${id}?attributes=id,available_quantity`,
        accessToken
      )
    )
  )

  const details = itemDetails
    .filter(r => r.status === 'fulfilled')
    .map(r => (r as PromiseFulfilledResult<{ id: string; available_quantity: number }>).value)

  const sinStock = details.filter(d => d.available_quantity === 0).length
  const skus_sin_stock_pct = (sinStock / details.length) * 100

  return {
    skus_sin_stock_pct,
    // dias_stock y lead_time_reposicion no disponibles en API → null (carga manual)
    dias_stock: null,
    lead_time_reposicion: null,
  }
}
