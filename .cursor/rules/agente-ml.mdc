# Tarea 5 — API Routes [IMPORTANTE]

## `app/api/ml/auth/callback/route.ts`
```typescript
// Recibe el code de OAuth después de que el seller autoriza
import { NextRequest, NextResponse } from 'next/server'
import { exchangeCodeForTokens } from '@/lib/ml/auth'
import { createServerClient } from '@/lib/supabase/server'

export async function GET(request: NextRequest) {
  const { searchParams } = new URL(request.url)
  const code = searchParams.get('code')
  const state = searchParams.get('state') // contiene el client_id de MeliGrowth
  const error = searchParams.get('error')

  if (error) {
    return NextResponse.redirect(`/operator/clients/${state}/settings?ml_error=${error}`)
  }

  if (!code || !state) {
    return NextResponse.redirect('/operator/dashboard?ml_error=invalid_callback')
  }

  try {
    const tokens = await exchangeCodeForTokens(
      code,
      process.env.ML_CLIENT_ID!,
      process.env.ML_CLIENT_SECRET!,
      process.env.ML_REDIRECT_URI!
    )

    // Guardar tokens en Supabase Storage (meli-sessions bucket)
    const supabase = await createServerClient()
    const storagePath = `${state}/${tokens.user_id}/session.json`
    const tokenData = {
      access_token: tokens.access_token,
      refresh_token: tokens.refresh_token,
      expires_at: Math.floor(Date.now() / 1000) + tokens.expires_in,
      seller_id: tokens.user_id.toString(),
    }

    await supabase.storage
      .from('meli-sessions')
      .upload(storagePath, JSON.stringify(tokenData), { upsert: true })

    // Crear o actualizar el registro en meli_sessions
    const { data: { user } } = await supabase.auth.getUser()
    await supabase.from('meli_sessions').upsert({
      client_id: state,
      seller_id: tokens.user_id.toString(),
      storage_path: storagePath,
      status: 'validated',
      last_validated_at: new Date().toISOString(),
      created_by: user?.id,
    })

    // Actualizar el seller_id en la tabla clients
    await supabase
      .from('clients')
      .update({ meli_seller_id: tokens.user_id.toString() })
      .eq('id', state)

    return NextResponse.redirect(
      `/operator/clients/${state}/settings?ml_connected=true`
    )
  } catch (err) {
    console.error('[ML OAuth callback]', err)
    return NextResponse.redirect(
      `/operator/clients/${state}/settings?ml_error=token_exchange_failed`
    )
  }
}
```

## `app/api/ml/sync/route.ts`
```typescript
// Dispara un sync manual de datos de ML para una cuenta
import { NextRequest, NextResponse } from 'next/server'
import { fetchMLDiagnosticData } from '@/lib/ml/pipeline'
import { createServerClient } from '@/lib/supabase/server'

export async function POST(request: NextRequest) {
  const { client_id } = await request.json()

  if (!client_id) {
    return NextResponse.json({ error: 'client_id requerido' }, { status: 400 })
  }

  // Verificar que el operador tiene acceso a este cliente
  const supabase = await createServerClient()
  const { data: client } = await supabase
    .from('clients')
    .select('id, meli_seller_id')
    .eq('id', client_id)
    .single()

  if (!client?.meli_seller_id) {
    return NextResponse.json(
      { error: 'Este cliente no tiene cuenta ML conectada' },
      { status: 400 }
    )
  }

  const result = await fetchMLDiagnosticData(client_id, client.meli_seller_id)

  if (!result.success) {
    return NextResponse.json({ error: result.error }, { status: 400 })
  }

  return NextResponse.json({ data: result.data })
}
```

