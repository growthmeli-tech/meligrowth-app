## `lib/ml/endpoints/reputation.ts` — Bloque 01 Salud
```typescript
import { mlFetch } from '../client'

export type MLReputationResponse = {
  level_id: string
  power_seller_status: string | null
  transactions: {
    period: string
    ratings: { positive: number; negative: number; neutral: number }
    canceled: number
    completed: number
  }
  metrics: {
    sales: { period: string; completed: number; declined: number }
    claims: { period: string; rate: number; value: number }
    delayed_handling_time: { period: string; rate: number; value: number }
    cancellations: { period: string; rate: number; value: number }
  }
}

export async function getSellerReputation(
  sellerId: string,
  accessToken: string
): Promise<MLReputationResponse> {
  return mlFetch<MLReputationResponse>(
    `/users/${sellerId}/seller_reputation`,
    accessToken
  )
}

// Mapea a los campos del diagnóstico del bloque 01
export function mapReputationToDiagnostic(rep: MLReputationResponse) {
  return {
    reclamos: rep.metrics.claims.rate * 100,                          // % reclamos
    mediaciones: rep.transactions.ratings.negative * 100,            // % mediaciones (proxy)
    cancelaciones_vendedor: rep.metrics.cancellations.rate * 100,    // % cancelaciones
    envios_a_tiempo: (1 - rep.metrics.delayed_handling_time.rate) * 100, // % a tiempo (inverso del delay)
  }
}
```

## `lib/ml/endpoints/listings.ts` — Bloque 02 Publicaciones
```typescript
import { mlFetch } from '../client'

export async function getListingsStats(sellerId: string, accessToken: string) {
  // Publicaciones activas
  const active = await mlFetch<{ paging: { total: number } }>(
    `/users/${sellerId}/items/search?status=active&limit=1`,
    accessToken
  )

  // Total de publicaciones
  const all = await mlFetch<{ paging: { total: number } }>(
    `/users/${sellerId}/items/search?limit=1`,
    accessToken
  )

  // Publicaciones pausadas
  const paused = await mlFetch<{ paging: { total: number } }>(
    `/users/${sellerId}/items/search?status=paused&limit=1`,
    accessToken
  )

  return {
    total: all.paging.total,
    active: active.paging.total,
    paused: paused.paging.total,
  }
}

// Calcula % de publicaciones optimizadas muestreando las top 50 por visitas
export async function getListingsOptimizationRate(
  sellerId: string,
  accessToken: string
): Promise<number> {
  const items = await mlFetch<{ results: string[] }>(
    `/users/${sellerId}/items/search?status=active&limit=50`,
    accessToken
  )

  if (!items.results.length) return 0

  // Obtener performance de cada publicación en paralelo (max 10 simultáneas)
  const batchSize = 10
  let optimizedCount = 0

  for (let i = 0; i < items.results.length; i += batchSize) {
    const batch = items.results.slice(i, i + batchSize)
    const performances = await Promise.allSettled(
      batch.map(itemId =>
        mlFetch<{ score: number; level_wording: string }>(
          `/item/${itemId}/performance`,
          accessToken
        )
      )
    )

    for (const result of performances) {
      if (result.status === 'fulfilled' && result.value.score >= 70) {
        optimizedCount++
      }
    }
  }

  return (optimizedCount / items.results.length) * 100
}

export function mapListingsToDiagnostic(stats: { total: number; active: number }, optimizationRate: number) {
  return {
    pubs_activas_pct: stats.total > 0 ? (stats.active / stats.total) * 100 : 0,
    pubs_optimizadas_pct: optimizationRate,
    // CTR → no disponible en API oficial → null (carga manual o scraper)
    ctr: null,
  }
}
