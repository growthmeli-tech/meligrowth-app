# Tarea 1 — OAuth flow completo [PRIMERO, todo depende de esto]

```typescript
// lib/ml/auth.ts

import { createServerClient } from '@/lib/supabase/server'
import { createServiceClient } from '@/lib/supabase/service'
import { logServerError } from '@/lib/utils/errors'

const ML_AUTH_URL = 'https://auth.mercadolibre.com.ar/authorization'
const ML_TOKEN_URL = 'https://api.mercadolibre.com/oauth/token'

// Genera la URL de autorización para que el seller autorice
export function getAuthorizationUrl(clientId: string, redirectUri: string, state: string): string {
  const params = new URLSearchParams({
    response_type: 'code',
    client_id: clientId,
    redirect_uri: redirectUri,
    state, // para prevenir CSRF — usar el client_id de la cuenta en Meli Growth
  })
  return `${ML_AUTH_URL}?${params.toString()}`
}

// Intercambia el code por access_token y refresh_token
export async function exchangeCodeForTokens(
  code: string,
  clientId: string,
  clientSecret: string,
  redirectUri: string
): Promise<{ access_token: string; refresh_token: string; user_id: number; expires_in: number }> {
  const response = await fetch(ML_TOKEN_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
    body: new URLSearchParams({
      grant_type: 'authorization_code',
      client_id: clientId,
      client_secret: clientSecret,
      code,
      redirect_uri: redirectUri,
    }),
  })

  if (!response.ok) {
    const error = await response.text()
    throw new Error(`ML OAuth error: ${error}`)
  }

  return response.json()
}

// Renueva el access_token usando el refresh_token
export async function refreshAccessToken(
  refreshToken: string,
  clientId: string,
  clientSecret: string
): Promise<{ access_token: string; refresh_token: string; expires_in: number }> {
  const response = await fetch(ML_TOKEN_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json' },
    body: new URLSearchParams({
      grant_type: 'refresh_token',
      client_id: clientId,
      client_secret: clientSecret,
      refresh_token: refreshToken,
    }),
  })

  if (!response.ok) {
    throw new Error(`ML token refresh failed: ${await response.text()}`)
  }

  return response.json()
}

// Obtiene el access_token vigente para un cliente — renueva si está por vencer
export async function getValidAccessToken(clientId: string): Promise<string> {
  const supabase = createServiceClient() // necesita bypasear RLS para leer sesiones

  const { data: session, error } = await supabase
    .from('meli_sessions')
    .select('*')
    .eq('client_id', clientId)
    .eq('status', 'validated')
    .order('created_at', { ascending: false })
    .limit(1)
    .single()

  if (error || !session) {
    throw new Error(`No hay sesión válida para el cliente ${clientId}`)
  }

  // El storage_path guarda el JSON con los tokens
  // Obtener tokens del Storage de Supabase
  const { data: tokenFile } = await supabase.storage
    .from('meli-sessions')
    .download(session.storage_path)

  if (!tokenFile) throw new Error('No se pudo leer el archivo de sesión')

  const tokens = JSON.parse(await tokenFile.text()) as {
    access_token: string
    refresh_token: string
    expires_at: number // timestamp unix
  }

  // Si el token expira en menos de 5 minutos, renovar
  const needsRefresh = Date.now() / 1000 > tokens.expires_at - 300

  if (!needsRefresh) return tokens.access_token

  // Renovar el token
  const fresh = await refreshAccessToken(
    tokens.refresh_token,
    process.env.ML_CLIENT_ID!,
    process.env.ML_CLIENT_SECRET!
  )

  // Guardar los tokens renovados
  const updatedTokens = {
    access_token: fresh.access_token,
    refresh_token: fresh.refresh_token,
    expires_at: Math.floor(Date.now() / 1000) + fresh.expires_in,
  }

  await supabase.storage
    .from('meli-sessions')
    .upload(session.storage_path, JSON.stringify(updatedTokens), { upsert: true })

  // Actualizar el timestamp en la tabla
  await supabase
    .from('meli_sessions')
    .update({ last_validated_at: new Date().toISOString(), updated_at: new Date().toISOString() })
    .eq('id', session.id)

  return fresh.access_token
}
```

