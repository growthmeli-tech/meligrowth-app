```typescript
import { mlFetch } from '../client'

export async function getAdsMetrics(
  advertiserId: string,
  accessToken: string,
  dateFrom: string, // YYYY-MM-DD
  dateTo: string
) {
  try {
    const metrics = await mlFetch<{
      results: Array<{
        spend: number
        organic_sales: number
        advertised_sales: number
        total_amount: number
      }>
    }>(
      `/advertising/advertisers/${advertiserId}/product_ads/reports?date_from=${dateFrom}&date_to=${dateTo}&metrics=spend,advertised_sales,total_amount`,
      accessToken
    )

    const totals = metrics.results.reduce(
      (acc, row) => ({
        spend: acc.spend + row.spend,
        ventas_ads: acc.ventas_ads + row.advertised_sales,
        ventas_totales: acc.ventas_totales + row.total_amount,
      }),
      { spend: 0, ventas_ads: 0, ventas_totales: 0 }
    )

    return totals
  } catch {
    // Mercado Ads API puede no estar disponible para todos los sellers
    return null
  }
}

export function mapAdsToDiagnostic(metrics: { spend: number; ventas_ads: number; ventas_totales: number } | null) {
  if (!metrics) return { gasto_ads: null, ventas_ads: null, ventas_totales: null }

  return {
    gasto_ads: metrics.spend,
    ventas_ads: metrics.ventas_ads,
    ventas_totales: metrics.ventas_totales,
    // ACOS, ROAS, TACOS se calculan en lib/scoring.ts — no acá
  }
}
